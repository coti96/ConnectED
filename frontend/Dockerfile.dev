# Utiliser une image Node.js récente pour le développement (Angular 17+ requiert Node 18.19.1+ ou 20.11.1+)
FROM node:22-alpine

WORKDIR /app

# Installer Angular CLI globalement
RUN npm install -g @angular/cli

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer les dépendances avec legacy-peer-deps pour éviter les conflits
RUN npm install --legacy-peer-deps

# Copier le reste du code source
COPY . .

# Exposer le port par défaut d'Angular
EXPOSE 4200

# Démarrer le serveur de développement avec hot-reload activé
# --host 0.0.0.0 permet d'accéder au serveur depuis l'extérieur du conteneur
# --poll 2000 force la vérification des changements de fichiers toutes les 2 secondes (utile sous Docker Windows)
CMD ["ng", "serve", "--host", "0.0.0.0", "--poll", "2000"]
